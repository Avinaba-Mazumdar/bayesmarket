{
    "name": "bayesmarket-monorepo",
    "version": "1.0.0",
    "private": true,
    "description": "Institutional-grade binary prediction market exchange engine and reactive trading platform",
    "license": "MIT",
    "author": "Avinaba Mazumdar",
    "repository": {
        "type": "git",
        "url": "https://github.com/Avinaba-Mazumdar/bayesmarket.git"
    },
    "scripts": {
        "dev:be": "cd backend && go run cmd/api/main.go",
        "dev:fe": "cd frontend && pnpm dev",
        "build:be": "cd backend && go build ./...",
        "build:fe": "cd frontend && pnpm build",
        "test:backend": "cd backend && go test -v ./...",
        "test:amm": "cd backend && go test -v ./internal/amm/...",
        "test:fe": "cd frontend && pnpm test:ci",
        "test": "pnpm test:backend && pnpm test:fe",
        "format:go": "cd backend && go fmt ./...",
        "lint:format": "pnpm --dir frontend exec prettier --ignore-path ../.prettierignore --check \"../**/*.{json,md,css,html,ts}\"",
        "format": "pnpm --dir frontend exec prettier --ignore-path ../.prettierignore --write \"../**/*.{json,md,css,html,ts}\" && cd backend && go fmt ./..."
    }
}
