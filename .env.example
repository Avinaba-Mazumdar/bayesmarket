# BayesMarket environment configuration
# Copy to .env. Do not commit .env.
#
# APP_ENV=local and APP_ENV=dev accept DATABASE_URL only when the host is
# localhost, 127.0.0.1, ::1, or postgres (the Compose service name).
# A hosted database requires APP_ENV=production.

# Local Postgres. Compose publishes the database on 127.0.0.1:5432 and
# defaults the user and database to bayesuser / bayesmarket.
DATABASE_URL=postgres://bayesuser:password@localhost:5432/bayesmarket?sslmode=disable

# Optional role that can migrate and DELETE or TRUNCATE. The runtime role
# documented in backend/scripts/setup_least_privilege_user.sql is limited to
# SELECT, INSERT, and UPDATE. When this URL differs from DATABASE_URL, the
# API opens a second pool for migrations, market deletes, and retention deletes.
# MIGRATION_DATABASE_URL=postgres://postgres:password@localhost:5432/bayesmarket?sslmode=disable

# Server
SERVER_PORT=8080
CORS_ORIGIN=http://localhost:4200
# local | dev | development | production. Empty defaults to production.
APP_ENV=local

# Required in every environment. At least 32 characters. There is no default.
JWT_SECRET=GENERATE_RANDOM_HMAC_SHA256_KEY_MIN_32_CHARS

# Refresh cookie SameSite. lax is the default. none is an explicit cross-site
# opt-in: the cookie is Secure, and browsers that block third-party cookies
# will drop the session. Prefer proxying /api on the frontend origin.
# COOKIE_SAMESITE=lax

# Comma-separated reverse-proxy IPs or CIDRs. Empty ignores X-Forwarded-For.
# Production logs a warning when this is empty.
# TRUSTED_PROXIES=127.0.0.1,::1

# Optional separate MAC key for the OAuth state cookie. At least 32 characters
# when set. When unset, the server derives a key from JWT_SECRET.
# OAUTH_STATE_SECRET=

# Google OAuth. Leave the client id empty for local guest-only use.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4200/auth/callback

# Migrations run on boot unless this is false, 0, or no.
# AUTO_MIGRATE=true
